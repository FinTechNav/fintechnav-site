# Contact form (configure privately in Netlify; never commit real values)
ZOHO_EMAIL=sender@example.test
ZOHO_APP_PASSWORD=replace-in-private-settings

# Server-enforced private stock account; missing configuration fails closed.
STOCK_OWNER_EMAIL_SHA256=replace-with-private-sha256-of-normalized-owner-email
# Optional JSON objects: primary and partner labels / previous internal identifiers.
STOCK_PROFILE_LABELS={"primary":"Primary","partner":"Partner"}
STOCK_PROFILE_LEGACY_IDS={"primary":"primary","partner":"partner"}
# Base64 gzip JSON of {"profiles":{"primary":<preferences>,"partner":<preferences>}}.
# Preferences are rules, watchlist, deployBudget and sessionTiming, without holdings or credentials.
STOCK_VIEW_SEED_GZIP=
